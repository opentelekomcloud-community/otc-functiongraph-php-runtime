{
  "name": "opentelekomcloud-community/fg-scratch-event-lts",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "opentelekomcloud-community/otc-functiongraph-php-runtime": "*"
  },
  "archive": {
    "exclude": [
      "Makefile",
      "resources/**",
      "vendor/opentelekomcloud-community",
      "!vendor/opentelekomcloud-community/otc-functiongraph-php-runtime/fg-events/fg-lts-event/src"
    ]
  },
  "config": {
    "archive-format": "zip",
    "optimize-autoloader": true    
  }
}
